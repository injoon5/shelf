  "ignore": [
    {
      "reason": "Built by the compiler or by other modifiers; no author writes them.",
      "match": { "ids": ["view:ModifiedContent", "view:TupleView", "view:TupleContent", "view:IDView", "view:SubscriptionView", "view:FillShapeView", "view:StrokeShapeView", "view:StrokeBorderShapeView", "view:OffsetShape", "view:RotatedShape", "view:ScaledShape", "view:TransformedShape", "view:PlaceholderContentView", "view:PresentedWindowContent", "view:PreviewModifierContent", "view:DebugReplaceableView", "view:LabeledControlGroupContent", "view:LabeledToolbarItemGroupContent", "view:ChartAxisContent", "view:ChartPlotContent", "view:AnyChartSymbolShape", "view:DefaultGlassEffectShape", "view:DefaultShareLinkLabel", "view:DefaultButtonLabel", "view:DefaultDateProgressLabel", "view:DefaultTabLabel", "view:DefaultNewDocumentButtonLabel", "view:DefaultDocumentGroupLaunchActions", "view:RealityViewDefaultPlaceholder", "view:DefaultUserAnnotationContent", "view:MapContentView", "view:MapSelectableContentView", "type:HierarchicalShapeStyleModifier", "content:ChartModifiedContent", "content:EmptyCommands", "content:EmptyTableRowContent", "content:TableForEachContent", "content:TableHeaderRowContent", "content:TableOutlineGroupContent", "content:FunctionAreaPlotContent", "content:FunctionLinePlotContent", "gesture:GestureStateGesture", "member:Color.transferRepresentation", "content:AccessibilityOptionalRotorContent", "content:AccessibilityTupleRotorContent"] }
    },
    {
      "reason": "Result-builder and availability wrappers, made by the compiler.",
      "match": { "idPatterns": ["^(view|content):(Tuple|Builder|LimitedAvailability|Vectorized)", "^view:Automatic"] }
    }
  ]
}
