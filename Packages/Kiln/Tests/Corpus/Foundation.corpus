    var days: [Int] = []
    Calendar.current.enumerateDates(startingAfter: ref, matching: DateComponents(hour: 0), matchingPolicy: .nextTime) { date, _, stop in
        if let date { days.append(Calendar.current.component(.day, from: date)) }
        if days.count == 3 { stop = true }
    }
    print(days)
