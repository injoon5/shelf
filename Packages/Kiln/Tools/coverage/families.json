    { "family": "Photos", "match": { "modules": ["_PhotosUI_SwiftUI"] } },
    { "family": "Web", "match": { "modules": ["_WebKit_SwiftUI"] } },
    { "family": "Maps", "match": { "modules": ["_MapKit_SwiftUI"] } },
    { "family": "Store", "match": { "modules": ["_StoreKit_SwiftUI"] } },
    { "family": "Wallet", "match": { "modules": ["_PassKit_SwiftUI"] } },
    { "family": "3D & Games", "match": { "modules": ["_RealityKit_SwiftUI", "_SceneKit_SwiftUI", "_SpriteKit_SwiftUI", "_GameController_SwiftUI"] } },
    { "family": "Media", "match": { "modules": ["_MusicKit_SwiftUI"] } },
    { "family": "Audio", "match": { "modules": ["_AVKit_SwiftUI"] } },
    { "family": "Sign-in", "match": { "modules": ["_AuthenticationServices_SwiftUI"] } },
    { "family": "System services", "match": { "modules": ["_AppIntents_SwiftUI", "_DeviceActivity_SwiftUI", "_ManagedAppDistribution_SwiftUI", "_PermissionKit_SwiftUI", "_SecureElementCredential_SwiftUI", "_DeviceDiscoveryUI_SwiftUI", "_HomeKit_SwiftUI", "_ScreenCaptureKit_SwiftUI", "_WorkoutKit_SwiftUI"] } },
    { "family": "Data", "match": { "modules": ["_SwiftData_SwiftUI"] } },
    { "family": "Translation", "match": { "modules": ["_Translation_SwiftUI"] } },
    { "family": "Location", "match": { "modules": ["_CoreLocationUI_SwiftUI", "_CoreLocation_SwiftUI"] } },
    { "family": "Motion", "match": { "modules": ["_CoreMotion_SwiftUI"] } },
    { "family": "Intelligence", "match": { "modules": ["_FoundationModels_SwiftUI", "_Vision_FoundationModels", "_CoreSpotlight_FoundationModels"] } },
    { "family": "Files", "match": { "modules": ["_QuickLook_SwiftUI"] } },
    { "family": "Text", "match": { "modules": ["_DataDetection_SwiftUI"] } },
    { "family": "Charts", "match": { "modules": ["Charts"] } },

    { "family": "Data", "match": { "names": ["FetchRequest", "SectionedFetchRequest", "managedObjectContext", "modelContext", "modelContainer"] } },
    { "family": "Store", "match": { "patterns": ["^appStore", "^manageSubscriptionsSheet$", "^refundRequestSheet$", "^offerCodeRedemption$", "^storeProduct", "^subscription", "^inAppPurchase", "^currentEntitlementTask$", "^transactionTask$", "^productDescription$", "^purchase$", "^requestReview$", "^displayStoreKitMessage$"] } },
    { "family": "Wallet", "match": { "patterns": ["^onApplePay", "ApplePay", "^payWith", "^payLater", "Wallet"] } },
    { "family": "Maps", "match": { "patterns": ["^map[A-Z]", "^lookAround"] } },
    { "family": "Translation", "match": { "patterns": ["^translation"] } },
    { "family": "Intelligence", "match": { "patterns": ["^writingTools"] } },
    { "family": "Widgets", "match": { "patterns": ["[Ww]idget"] } },
    { "family": "Files", "match": { "patterns": ["^file(Importer|Exporter|Mover|Dialog|ExporterFilenameLabel)", "^draggable$", "^dropDestination$", "^onDrag", "^onDrop", "^drag(Container|Configuration)", "^dropConfiguration$", "^itemProvider$", "^springLoadingBehavior$", "^exportableToServices$", "^importableFromServices$", "^quickLookPreview$", "^documentBrowser"] } },
