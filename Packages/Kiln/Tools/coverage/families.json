    { "family": "Drawing", "match": { "kinds": ["view"], "patterns": ["(Shape|Gradient|Rectangle|Circle|Capsule|Ellipse)$", "^(Canvas|Color|Image|AsyncImage|Path|GlassEffectContainer|PhaseAnimator|KeyframeAnimator|TimelineView)$"] } },

    { "family": "Accessibility", "match": { "kinds": ["modifier"], "patterns": ["^accessibility", "^speech", "^assistiveAccess"] } },
    { "family": "Haptics", "match": { "kinds": ["modifier"], "patterns": ["^sensoryFeedback"] } },
    { "family": "Focus & Keyboard", "match": { "kinds": ["modifier"], "patterns": ["^focus", "^defaultFocus$", "^onSubmit$", "^submit(Label|Scope)$", "^keyboard", "^textContentType$", "^textInputAutocapitalization$", "^autocapitalization$", "^autocorrectionDisabled$", "^disableAutocorrection$", "^scrollDismissesKeyboard$", "^onKeyPress$", "^searchFocused$", "^typeSelectEquivalent$", "^onMoveCommand$", "^onExitCommand$", "^onCommand$"] } },
