    { "family": "Navigation", "match": { "kinds": ["environment"], "patterns": ["^dismiss$", "^isPresented$", "^isSearching$", "^dismissSearch$", "^editMode$", "^presentationMode$", "^isTabBar", "^tabView", "^navigation", "^searchSuggestionsPlacement$", "^toolbar"] } },
