    { "family": "Drawing", "match": { "kinds": ["modifier"], "patterns": ["Effect$", "^glassEffect", "^symbol", "^(union|intersection|subtracting|symmetricDifference|lineIntersection|lineSubtraction)$", "^(accentColor|allowedDynamicRange|animation|antialiased|asyncImageURLSession|background|backgroundStyle|blendMode|blur|border|brightness|clipShape|clipped|colorInvert|colorMultiply|compositingGroup|contentTransition|contrast|cornerRadius|drawingGroup|fill|foregroundColor|foregroundStyle|grayscale|hidden|hueRotation|imageScale|interpolation|keyframeAnimator|luminanceToAlpha|mask|materialActiveAppearance|opacity|overlay|phaseAnimator|renderingMode|resizable|saturation|shadow|stroke|strokeBorder|transaction|transition|trim|inset|rotation|scale|transform)$"] } }
