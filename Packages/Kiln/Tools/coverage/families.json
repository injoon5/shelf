    { "family": "Scenes", "match": { "names": ["DocumentLaunchView", "NewDocumentButton", "DocumentGroupLaunchScene", "openWindow", "dismissWindow", "pushWindow", "openDocument", "newDocument", "documentConfiguration", "supportsMultipleWindows", "openImmersiveSpace", "dismissImmersiveSpace", "supportsRemoteScenes", "requestGeometryUpdate", "navigationDocument", "focusedSceneValue", "focusedSceneObject", "documentLaunchTitle", "documentLaunchSubtitle", "userActivity", "onContinueUserActivity", "handlesExternalEvents", "sceneAccessory", "windowToolbarFullScreenVisibility", "allowsWindowActivationEvents", "staticAllowsWindowActivationEvents", "onInteractiveResizeChange", "UIApplicationDelegateAdaptor", "scenePadding", "presentedWindowContent", "dismissWindowBehavior", "windowResizability", "openSettings", "defaultAppStorage", "persistentSystemOverlays"] } },

    { "family": "Gestures", "match": { "kinds": ["gesture"] } },
    { "family": "Gestures", "match": { "owners": ["Gesture"] } },
    { "family": "Navigation", "match": { "owners": ["ToolbarContent", "TabContent"] } },
    { "family": "Lists", "match": { "owners": ["TableColumnContent", "TableRowContent"] } },
