Array.sorted(using: KeyPathComparator order:) ::
    struct P { var name: String; var age: Int }
    let ps = [P(name: "a", age: 3), P(name: "b", age: 1), P(name: "c", age: 2)]
    print(ps.sorted(using: KeyPathComparator(\.age, order: .reverse)).map(\.name))
=> ["a", "c", "b"]
Array.sorted(using: [KeyPathComparator]) ::
    struct P { var name: String; var age: Int }
    let ps = [P(name: "b", age: 1), P(name: "a", age: 1), P(name: "c", age: 0)]
    print(ps.sorted(using: [KeyPathComparator(\.age), KeyPathComparator(\.name)]).map(\.name))
=> ["c", "a", "b"]
Array.sorted(using: SortDescriptor) ::
    struct P { var name: String; var age: Int }
