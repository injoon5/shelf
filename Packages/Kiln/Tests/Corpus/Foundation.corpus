String.range(of:options: .backwards) :: { let s = "a.b.c"; let r = s.range(of: ".", options: .backwards)!; return String(s[r.upperBound...]) }() => c
String.range(of:options: .regularExpression) :: { let s = "id: 4821"; let r = s.range(of: "[0-9]+", options: .regularExpression)!; return String(s[r]) }() => 4821
String.replacingOccurrences(of:with:) :: "a-b-c".replacingOccurrences(of: "-", with: "+") => a+b+c
String.replacingOccurrences options :: "Cat cat".replacingOccurrences(of: "cat", with: "dog", options: .caseInsensitive) => dog dog
String.replacingOccurrences regex :: "a1b22c333".replacingOccurrences(of: "[0-9]+", with: "#", options: .regularExpression) => a#b#c#
String.contains :: "Swift".contains("if") => true
String.localizedCaseInsensitiveContains :: "Straße".localizedCaseInsensitiveContains("STRASSE") => true
String.localizedStandardContains :: "Café".localizedStandardContains("cafe") => true
String.localizedCompare :: "a".localizedCompare("B") == .orderedAscending => true
String.localizedCaseInsensitiveCompare :: "a".localizedCaseInsensitiveCompare("B") == .orderedAscending => true
String.localizedStandardCompare :: ["file10", "file2", "File1"].sorted { $0.localizedStandardCompare($1) == .orderedAscending } => ["File1", "file2", "file10"]
String.compare :: "b".compare("a") => NSComparisonResult
String.compare(_:options:) :: "ABC".compare("abc", options: .caseInsensitive) == .orderedSame => true
String.compare numeric :: "item9".compare("item10", options: .numeric) == .orderedAscending => true
String.caseInsensitiveCompare :: "Apple".caseInsensitiveCompare("apple") == .orderedSame => true
String.capitalized :: "hello wide world".capitalized => Hello Wide World
String.localizedCapitalized :: "hello world".localizedCapitalized => Hello World
String.uppercased(with:) :: "istanbul".uppercased(with: Locale(identifier: "tr_TR")) => İSTANBUL
String.padding(toLength:withPad:startingAt:) :: "ab".padding(toLength: 5, withPad: ".", startingAt: 0) => ab...
String.folding(options:locale:) :: "Crème Brûlée".folding(options: .diacriticInsensitive, locale: .current) => Creme Brulee
String.applyingTransform :: "Привет".applyingTransform(.toLatin, reverse: false) ?? "nil" => Privet
String.addingPercentEncoding :: "a b&c".addingPercentEncoding(withAllowedCharacters: .urlQueryAllowed) ?? "nil" => a%20b&c
String.removingPercentEncoding :: "a%20b".removingPercentEncoding ?? "nil" => a b
String.data(using:) :: "héllo".data(using: .utf8)!.count => 6
String(data:encoding:) :: String(data: Data("hi".utf8), encoding: .utf8) ?? "nil" => hi
String(decoding:as:) :: String(decoding: Data("hi".utf8), as: UTF8.self) => hi
String.lengthOfBytes(using:) :: "héllo".lengthOfBytes(using: .utf8) => 6
String.enumerateLines ::
    var n = 0
    "a\nb\nc".enumerateLines { _, _ in n += 1 }
    print(n)
=> 3
String.components(separatedBy: .newlines) :: "a\nb\r\nc".components(separatedBy: .newlines).count => 4
String.hasPrefix/hasSuffix :: "photo.png".hasSuffix(".png") && "photo.png".hasPrefix("ph") => true
String.appendingFormat :: "x".appendingFormat("%d", 5) => x5
String.appending :: "a".appending("b") => ab
NSString.pathExtension :: ("photo.final.png" as NSString).pathExtension => png
NSString.lastPathComponent :: ("/a/b/c.txt" as NSString).lastPathComponent => c.txt
NSString.deletingPathExtension :: ("c.txt" as NSString).deletingPathExtension => c
String.abbreviatingWithTildeInPath-free URL path :: URL(fileURLWithPath: "/tmp/x/y.txt").deletingLastPathComponent().path => /tmp/x
AttributedString(markdown:) :: String(try! AttributedString(markdown: "**bold** text").characters) => bold text
AttributedString characters :: AttributedString("hello").characters.count => 5
NSAttributedString(string:) :: NSAttributedString(string: "x").string => x
NSAttributedString.length :: NSAttributedString(string: "héllo").length => 5
NSMutableAttributedString.append ::
    let s = NSMutableAttributedString(string: "a")
    s.append(NSAttributedString(string: "b"))
    print(s.string, s.length)
=> ab 2
NSAttributedString(attributes:) :: NSAttributedString(string: "big", attributes: [.kern: 2]).string => big
AttributedString(NSAttributedString) :: String(AttributedString(NSAttributedString(string: "conv")).characters) => conv

## Data and encoding

Data(String.utf8) :: Data("hi".utf8).count => 2
Data([UInt8]) :: Data([0x48, 0x69]) => 2 bytes
Data.base64EncodedString() :: Data("hi".utf8).base64EncodedString() => aGk=
Data(base64Encoded:) :: String(data: Data(base64Encoded: "aGk=")!, encoding: .utf8)! => hi
Data(base64Encoded:) invalid :: Data(base64Encoded: "!!") == nil => true
Data.map hex :: Data([0x0f, 0xa0]).map { String(format: "%02x", $0) }.joined() => 0fa0
Data subscript :: Data([1, 2, 3])[1] => 2
Data.append :: { var d = Data([1]); d.append(contentsOf: [2, 3]); d.append(4); return d.count }() => 4
Data.first :: Data([9, 8]).first! => 9
Data equality :: Data([1, 2]) == Data([1, 2]) => true
Data.prefix :: Data([1, 2, 3]).prefix(2).count => 2
Data.reduce :: Data([1, 2, 3]).reduce(0) { $0 + Int($1) } => 6
Array(Data) :: Array(Data("AB".utf8)) => [65, 66]
SHA256.hash(data:) :: SHA256.hash(data: Data("a".utf8)).description => SHA256 digest: ca978112ca1bbdcafac231b39a23dc4da786eff8147c4e72b9807785afee48bb
SHA256 hex :: SHA256.hash(data: Data("abc".utf8)).map { String(format: "%02x", $0) }.joined() => ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
SHA256 compactMap :: SHA256.hash(data: Data("abc".utf8)).compactMap { String(format: "%02x", $0) }.joined().prefix(8) => ba7816bf
Insecure.MD5 :: Insecure.MD5.hash(data: Data("abc".utf8)).map { String(format: "%02x", $0) }.joined() => 900150983cd24fb0d6963f7d28e17f72
SHA512 :: Array(SHA512.hash(data: Data("abc".utf8))).count => 64
JSONSerialization.jsonObject(with:) :: String(describing: try! JSONSerialization.jsonObject(with: Data("[1]".utf8)))
=> (
=>     1
=> )
JSONSerialization dictionary :: (try! JSONSerialization.jsonObject(with: Data(#"{"a": 2}"#.utf8)) as! [String: Any])["a"] as! Int => 2
JSONSerialization.data(withJSONObject:) :: String(data: try! JSONSerialization.data(withJSONObject: ["a": 1]), encoding: .utf8)! => {"a":1}
JSONSerialization.data sortedKeys :: String(data: try! JSONSerialization.data(withJSONObject: ["b": 1, "a": [true, "x"]], options: [.sortedKeys]), encoding: .utf8)! => {"a":[true,"x"],"b":1}
JSONSerialization.isValidJSONObject :: JSONSerialization.isValidJSONObject(["a": [1, 2]]) => true
JSONEncoder.encode :: String(data: try! JSONEncoder().encode([1, 2]), encoding: .utf8)! => [1,2]
JSONEncoder.outputFormatting sortedKeys ::
    struct P: Codable { var b = 1; var a = "x" }
    let e = JSONEncoder()
    e.outputFormatting = [.sortedKeys]
    print(String(data: try! e.encode(P()), encoding: .utf8)!)
=> {"a":"x","b":1}
JSONEncoder.keyEncodingStrategy ::
    struct P: Codable { var firstName = "A" }
    let e = JSONEncoder()
    e.keyEncodingStrategy = .convertToSnakeCase
    print(String(data: try! e.encode(P()), encoding: .utf8)!)
=> {"first_name":"A"}
JSONDecoder.keyDecodingStrategy ::
    struct P: Codable { var firstName: String }
    let d = JSONDecoder()
    d.keyDecodingStrategy = .convertFromSnakeCase
    print(try! d.decode(P.self, from: Data(#"{"first_name":"Bo"}"#.utf8)).firstName)
=> Bo
JSONDecoder.dateDecodingStrategy ::
    struct E: Codable { var at: Date }
    let d = JSONDecoder()
    d.dateDecodingStrategy = .iso8601
    print(try! d.decode(E.self, from: Data(#"{"at":"2026-03-14T19:09:26Z"}"#.utf8)).at == ref)
=> true
JSONEncoder.dateEncodingStrategy ::
    struct E: Codable { var at: Date }
    let e = JSONEncoder()
    e.dateEncodingStrategy = .iso8601
    print(String(data: try! e.encode(E(at: ref)), encoding: .utf8)!)
=> {"at":"2026-03-14T19:09:26Z"}
JSONDecoder error :: (try? JSONDecoder().decode([Int].self, from: Data("{".utf8))) == nil => true
PropertyListEncoder.encode :: try! PropertyListEncoder().encode([1]).count > 0 => true
PropertyListDecoder round trip ::
    struct S: Codable { var n: Int; var s: String }
    let data = try! PropertyListEncoder().encode(S(n: 3, s: "x"))
    let back = try! PropertyListDecoder().decode(S.self, from: data)
    print(back.n, back.s)
=> 3 x
PropertyListEncoder.outputFormat xml ::
    let e = PropertyListEncoder()
    e.outputFormat = .xml
    print(String(data: try! e.encode(["k": 1]), encoding: .utf8)!.contains("<key>k</key>"))
=> true
PropertyListSerialization ::
    let data = try! PropertyListSerialization.data(fromPropertyList: ["a": 1], format: .binary, options: 0)
    let back = try! PropertyListSerialization.propertyList(from: data, format: nil) as! [String: Int]
    print(back["a"]!)

=> 1
## Decimal

Decimal(string:) + Decimal :: (Decimal(string: "1.10")! + Decimal(2)).description => 3.1
Decimal(_ Double) :: Decimal(3.5) => 3.5
Decimal exact :: Decimal(string: "0.1")! + Decimal(string: "0.2")! == Decimal(string: "0.3")! => true
Decimal * / :: Decimal(10) / Decimal(4) * Decimal(3) => 7.5
Decimal comparison :: Decimal(2) < Decimal(string: "2.5")! => true
Decimal.formatted(.currency) :: Decimal(3.5).formatted(.currency(code: "USD")) => $3.50
Decimal.formatted(.number) :: Decimal(string: "1234.5")!.formatted(.number.precision(.fractionLength(2))) => 1,234.50
Decimal.rounded ::
    var x = Decimal(string: "2.675")!
    var r = Decimal()
    NSDecimalRound(&r, &x, 2, .plain)
    print(r)
=> 2.68
NSDecimalNumber.doubleValue :: NSDecimalNumber(decimal: Decimal(string: "1.25")!).doubleValue => 1.25
Decimal from Int literal :: { let d: Decimal = 7; return d * 2 }() => 14
Decimal sum :: [Decimal(string: "0.1")!, Decimal(string: "0.2")!].reduce(0, +) => 0.3
Decimal.isZero :: Decimal(0).isZero => true
Decimal(Int) :: Decimal(42).description => 42
Decimal negation :: -Decimal(string: "1.5")! => -1.5
Decimal(sign:exponent:significand:) :: Decimal(sign: .plus, exponent: -2, significand: 1999) => 19.99
Decimal += :: { var t = Decimal(0); for _ in 0..<3 { t += Decimal(string: "0.1")! }; return t }() => 0.3

## Timers and queues

Timer(timeInterval:repeats:block:) :: { let t = Timer(timeInterval: 1, repeats: false) { _ in }; t.invalidate(); return "ok" }() => ok
Timer.scheduledTimer.isValid :: { let t = Timer.scheduledTimer(withTimeInterval: 10, repeats: true) { _ in }; let v = t.isValid; t.invalidate(); return "\(v) \(t.isValid)" }() => true false
DispatchGroup :: { let g = DispatchGroup(); g.enter(); g.leave(); return "ok" }() => ok
DispatchGroup.notify ::
    let g = DispatchGroup()
    var log: [String] = []
    g.enter()
    log.append("work")
    g.leave()
    g.notify(queue: .main) { print("notified") }
    print(log)
=> ["work"]
DispatchSemaphore :: { let s = DispatchSemaphore(value: 1); s.wait(); s.signal(); return "ok" }() => ok
DispatchQueue.main.async :: { DispatchQueue.main.async { }; return "ok" }() => ok
DispatchQueue(label:) :: { let q = DispatchQueue(label: "work"); q.sync { }; return q.label }() => work
DispatchTime.now() :: DispatchTime.now() < DispatchTime.now() + 1 => true
OperationQueue.main :: OperationQueue.main.maxConcurrentOperationCount != 0 => true

## Images

UIGraphicsImageRenderer [ios] :: UIGraphicsImageRenderer(size: CGSize(width: 2, height: 2)).image { _ in }.size.width => 2.0
UIGraphicsImageRenderer fill [ios] ::
    let image = UIGraphicsImageRenderer(size: CGSize(width: 4, height: 3)).image { ctx in
        UIColor.red.setFill()
        ctx.fill(CGRect(x: 0, y: 0, width: 4, height: 3))
    }
    print(image.size)
=> (4.0, 3.0)
