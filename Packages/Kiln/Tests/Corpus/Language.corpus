    struct Mul { let k: Int; func callAsFunction(_ x: Int, plus y: Int = 0) -> Int { x * k + y } }
    let m = Mul(k: 3)
    print(m(2), m(2, plus: 1), m.callAsFunction(1))
=> 6 7 3
callAsFunction mutating ::
    struct Counter { var n = 0; mutating func callAsFunction() { n += 1 } }
    var c = Counter()
    c()
    c()
    print(c.n)
=> 2
custom Sequence ::
    struct Count: Sequence, IteratorProtocol { var n = 0; mutating func next() -> Int? { n += 1; return n <= 3 ? n : nil } }
    print(Count().map(String.init).joined())
=> 123
custom Sequence for-in ::
    struct Countdown: Sequence { let start: Int
        func makeIterator() -> Iterator { Iterator(n: start) }
        struct Iterator: IteratorProtocol { var n: Int; mutating func next() -> Int? { if n == 0 { return nil }; defer { n -= 1 }; return n } } }
    var out: [Int] = []
    for x in Countdown(start: 3) { out.append(x) }
    print(out, Countdown(start: 2).reduce(0, +), Array(Countdown(start: 2)))
=> [3, 2, 1] 3 [2, 1]
custom Sequence methods ::
    struct Evens: Sequence, IteratorProtocol { var n = 0; mutating func next() -> Int? { n += 2; return n <= 8 ? n : nil } }
    print(Evens().filter { $0 > 2 }, Evens().contains(6), Evens().first(where: { $0 > 3 })!, Evens().max()!)
=> [4, 6, 8] true 4 8
AnyIterator ::
    var i = 0
    let it = AnyIterator<Int> { i += 1; return i <= 2 ? i : nil }
    print(Array(it))
=> [1, 2]
string switch prefix ::
    let s = "apple"
    switch s { case let x where x.hasPrefix("a"): print("A"); default: print("?") }
=> A
character ops ::
    let c: Character = "b"
    print(String(Character(UnicodeScalar(c.unicodeScalars.first!.value + 1)!)) + String(c.isLetter))
=> ctrue
closure as variable ::
    let add: (Int, Int) -> Int = { $0 + $1 }
    print(add(2, 3))
=> 5
closure trailing multiple ::
    func both(_ a: () -> Int, then b: (Int) -> Int) -> Int { b(a()) }
    print(both { 2 } then: { $0 * 10 })
=> 20
escaping closure store ::
    var handlers: [() -> Int] = []
    func add(_ h: @escaping () -> Int) { handlers.append(h) }
    add { 1 }
    add { 2 }
    print(handlers.map { $0() })
=> [1, 2]
autoclosure ::
    func check(_ c: @autoclosure () -> Bool) -> String { c() ? "yes" : "no" }
    print(check(2 > 1))
=> yes
generic constraint protocol ::
    protocol Named { var name: String { get } }
    struct D: Named { var name = "d" }
    func names<T: Named>(_ xs: [T]) -> [String] { xs.map(\.name) }
    print(names([D(), D(name: "e")]))
=> ["d", "e"]
some return ::
    protocol Shape { func area() -> Double }
    struct Sq: Shape { var s: Double; func area() -> Double { s * s } }
    func make() -> some Shape { Sq(s: 3) }
    print(make().area())
=> 9.0
protocol static requirement ::
    protocol Zero { static var zero: Self { get } }
    struct V: Zero { var x = 0; static var zero: V { V() } }
    print(V.zero.x)
=> 0
Equatable synthesized enum ::
    enum E: Equatable { case a(Int), b }
    print(E.a(1) == .a(1), E.a(1) == .b)
=> true false
Comparable enum ::
    enum Size: Int, Comparable { case s, m, l; static func < (a: Size, b: Size) -> Bool { a.rawValue < b.rawValue } }
    print([Size.l, .s, .m].sorted().map { "\($0)" }, Size.s < .l)
=> ["s", "m", "l"] true
Identifiable ::
    struct Item: Identifiable { let id = 7 }
    print(Item().id)
=> 7
nested types ::
    struct Outer { struct Inner { var v = 3 }; var i = Inner() }
    print(Outer().i.v, Outer.Inner().v)
=> 3 3
static func on enum ::
    enum Math { static func double(_ x: Int) -> Int { x * 2 } }
    print(Math.double(4))
=> 8
where clause in for ::
    var s = 0
    for i in 1...10 where i % 3 == 0 { s += i }
    print(s)
=> 18
tuple comparison :: (1, "b") < (1, "c") => true
tuple swap ::
    var a = 1, b = 2
    (a, b) = (b, a)
    print(a, b)
=> 2 1
swap :: { var a = [1, 2]; a.swapAt(0, 1); var x = 1, y = 2; swap(&x, &y); return "\(a) \(x)\(y)" }() => [2, 1] 21
type(of:) :: type(of: 3) => Int
Self in protocol extension ::
    protocol Copyable { func copy() -> Self }
    struct P: Copyable { var v = 1; func copy() -> P { self } }
    print(P().copy().v)
=> 1
mutating method on enum ::
    enum Light { case on, off; mutating func toggle() { self = self == .on ? .off : .on } }
    var l = Light.on
    l.toggle()
    print(l)
=> off
Bool.toggle :: { var b = false; b.toggle(); return b }() => true
precondition passes :: { precondition(true); return "ok" }() => ok
fatalError-free assert :: { assert(1 < 2); return "ok" }() => ok
generic typealias ::
    typealias Pair<T> = (T, T)
    let p: Pair<Int> = (1, 2)
    print(p.0 + p.1)
=> 3
shadowing in if let :: { let x: Int? = 3; if let x { return x * 2 }; return 0 }() => 6
string interpolation expression :: { let n = 3; return "n=\(n * 2), \(n > 2 ? "big" : "small")" }() => n=6, big
guard let self in a weak closure ::
    final class Counter {
        var n = 1
        func adder() -> () -> Int {
            { [weak self] in
                guard let self else { return 0 }
                self.n += 1
                return self.n
            }
        }
    }
    let c = Counter()
    let add = c.adder()
    print(add(), add())
=> 2 3
