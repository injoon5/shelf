    { "family": "Layout", "match": { "kinds": ["protocol"], "names": ["Layout", "ContainerValueKey"] } },
    { "family": "Drawing", "match": { "kinds": ["protocol"], "names": ["Shape", "InsettableShape", "Animatable", "AnimatableModifier", "Transition", "CustomAnimation", "VectorArithmetic", "TextRenderer", "VisualEffect"] } },
    { "family": "Environment", "match": { "kinds": ["protocol"], "names": ["EnvironmentKey", "PreferenceKey"] } },
