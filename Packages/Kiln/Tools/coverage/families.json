{
  "families": [
    { "name": "Core", "round": 1, "summary": "The app and view protocols, lifecycle (`onAppear`, `task`, `onChange`), `ViewModifier`, and the macros (`@Entry`, `#Preview`)." },
    { "name": "Controls", "round": 1, "summary": "Buttons, toggles, pickers (every `DatePicker` style, `MultiDatePicker`), sliders, steppers, text fields, menus, and their styles." },
    { "name": "Text", "round": 1, "summary": "`Text`, fonts and typography modifiers, `AttributedString`, data detection." },
    { "name": "Layout", "round": 1, "summary": "Stacks, grids, `Layout`, frames, padding, safe areas, scroll views and scroll behaviour." },
    { "name": "Lists", "round": 1, "summary": "`List`, `Section`, `ForEach`, `Table`, row modifiers, swipe actions and reordering (iOS 27 outside `List`)." },
    { "name": "Navigation", "round": 1, "summary": "Stacks, split views, tabs, toolbars, search, sheets, popovers, alerts and other presentations." },
    { "name": "Gestures", "round": 1, "summary": "Gesture types, gesture modifiers, `@GestureState`, hit testing and hover." },
    { "name": "Drawing", "round": 1, "summary": "Shapes, colours, gradients, `Canvas`, images and symbols, visual effects, glass, animation and transitions." },
    { "name": "Focus & Keyboard", "round": 1, "summary": "`@FocusState`, `.focused`, submit, keyboard types and text input traits." },
    { "name": "Environment", "round": 1, "summary": "`@State` and the other property wrappers, environment values, `environment`, preferences, redaction." },
    { "name": "Accessibility", "round": 1, "summary": "`accessibility*` modifiers, rotors, speech." },
    { "name": "Charts", "round": 1, "summary": "Swift Charts: `Chart`, marks, plots, axes, scales, selection and scrolling." },
    { "name": "Scenes", "round": 1, "summary": "Scenes, windows, documents and commands. A Shelf app is one view in a card, so mostly won't do; `WindowGroup` is the app's root." },
    { "name": "Haptics", "round": 2, "summary": "`.sensoryFeedback` (§3.1)." },
    { "name": "Sharing", "round": 2, "summary": "`ShareLink`, `PasteButton`, copy and paste, text selection (§3.2)." },
    { "name": "Units", "round": 2, "summary": "`Measurement` and formatters (§3.4): Foundation, so type bridges rather than SwiftUI." },
    { "name": "Audio", "round": 2, "summary": "Playback (§3.5), and AVKit's `VideoPlayer`." },
    { "name": "Web", "round": 2, "summary": "`WebView`, `WebPage` and the `webView*` modifiers (§3.6)." },
    { "name": "Chart3D", "round": 2, "summary": "`Chart3D`, `SurfacePlot`, 3D marks, pose and projection (§3.7)." },
    { "name": "Files", "round": 3, "summary": "File importer, exporter and mover, Quick Look, drag and drop (§4.1)." },
    { "name": "Photos", "round": 3, "summary": "`PhotosPicker` and the `photosPicker` modifiers (§4.2)." },
    { "name": "Camera", "round": 3, "summary": "The camera through `UIImagePickerController` (§4.3); SwiftUI's capture-button hooks." },
    { "name": "Motion", "round": 3, "summary": "Core Motion (§4.5). `_CoreMotion_SwiftUI` is empty, so this is all type bridges." },
    { "name": "Location", "round": 3, "summary": "`LocationButton` and Core Location (§4.6)." },
    { "name": "Vision", "round": 4, "summary": "Vision and VisionKit (§5.1, §5.2): type bridges, no SwiftUI views." },
    { "name": "Intelligence", "round": 4, "summary": "Foundation Models (§5.3), its built-in Vision tools, and Writing Tools." },
    { "name": "Widgets", "round": 5, "summary": "What a widget's view uses: `containerBackground`, widget environment values (§6). WidgetKit itself isn't read." },
    { "name": "Maps", "round": null, "summary": "MapKit's views. Won't do." },
    { "name": "Store", "round": null, "summary": "StoreKit's views and in-app purchase modifiers." },
    { "name": "Wallet", "round": null, "summary": "Apple Pay and Wallet buttons (PassKit)." },
    { "name": "3D & Games", "round": null, "summary": "RealityKit, SceneKit, SpriteKit and game controllers." },
    { "name": "Media", "round": null, "summary": "MusicKit's artwork, picker and subscription offer." },
    { "name": "Sign-in", "round": null, "summary": "Sign in with Apple." },
    { "name": "System services", "round": null, "summary": "App Intents' Siri and Shortcuts views, Screen Time, managed apps, PermissionKit, HomeKit, WorkoutKit, device discovery." },
    { "name": "Data", "round": null, "summary": "SwiftData and Core Data in SwiftUI. Won't do: `DB` is the store." },
    { "name": "Translation", "round": null, "summary": "Translation's sheet and session task. On the Later list." }
  ],

  "rules": [
    { "family": "Sharing", "match": { "ids": ["view:ShareLink", "view:PasteButton", "modifier:copyable", "modifier:cuttable", "modifier:pasteDestination", "modifier:textSelection", "modifier:textSelectionAffinity", "type:TextSelection"] } },
    { "family": "Haptics", "match": { "ids": ["modifier:sensoryFeedback", "type:SensoryFeedback"] } },
    { "family": "Camera", "match": { "ids": ["modifier:onCameraCaptureEvent", "content:CameraCaptureAccessory"] } },
    { "family": "Widgets", "match": { "ids": ["modifier:containerBackground", "modifier:invalidatableContent"] } },
    { "family": "Chart3D", "match": { "ids": ["view:Chart3D", "content:SurfacePlot", "protocol:Chart3DSurfaceStyle"] } },
