    { "family": "Lists", "match": { "kinds": ["modifier"], "patterns": ["^list", "^swipeActions", "^reorder", "^onDelete$", "^onMove$", "^onInsert$", "^deleteDisabled$", "^moveDisabled$", "^refreshable$", "^sectionIndexLabel$", "^headerProminence$", "^selectionDisabled$", "^table", "^badge", "^replaceDisabled$", "^findDisabled$", "^findNavigator$"] } },
