NotificationCenter.addObserver(forName:) ::
    var got = ""
    let token = NotificationCenter.default.addObserver(forName: Notification.Name("ping"), object: nil, queue: nil) { note in
        got = note.name.rawValue
    }
    NotificationCenter.default.post(name: Notification.Name("ping"), object: nil)
    NotificationCenter.default.removeObserver(token)
    print(got)
=> ping
